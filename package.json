{
  "name": "@sargunv/workflow",
  "version": "0.1.0",
  "description": "Deterministic multi-agent workflows across coding agent harnesses",
  "type": "module",
  "keywords": ["agents", "workflow", "orchestration", "claude", "codex", "cli"],
  "homepage": "https://github.com/sargunv/workflow-cli#readme",
  "bugs": "https://github.com/sargunv/workflow-cli/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sargunv/workflow-cli.git"
  },
  "license": "MIT",
  "author": "Sargun Vohra",
  "bin": { "workflow-cli": "dist/cli.js" },
  "publishConfig": { "access": "public" },
  "files": ["dist", "skills", "examples", "README.md"],
  "engines": { "node": ">=24" },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "dev": "node src/cli.ts",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "ajv": "^8.20.0",
    "commander": "^15.0.0",
    "quickjs-emscripten": "^0.32.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2",
    "vite-plus": "^1.1.0"
  }
}
